---
import Layout from "../layouts/Layout.astro";
import LearningList from "../components/LearningList.astro";
import { publications } from "../data/publications";
import { site } from "../data/site";
---

<Layout title="Publications" description={`Publications — ${site.name}`}>
  <div class="max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight">Publications</h1>
    <p class="mt-3 text-lg text-zinc-400">
      Papers I have published, submitted, or proposed.
    </p>

    <LearningList
      items={publications.map((publication) => ({
        title: publication.title,
        authors: publication.authors,
        venue: publication.venue,
        year: publication.year,
        status: publication.status,
        url: publication.url,
        notes: publication.notes,
      }))}
      empty="No publications listed yet."
    />
  </div>
</Layout>
