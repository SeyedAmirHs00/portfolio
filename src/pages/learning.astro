---
import Layout from "../layouts/Layout.astro";
import LearningList from "../components/LearningList.astro";
import { articles, books, courses } from "../data/learning";
import { site } from "../data/site";
---

<Layout title="Learning" description={`Learning — ${site.name}`}>
  <div class="max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight">Learning</h1>
    <p class="mt-3 text-lg text-zinc-400">
      Articles, books, and courses I have read, watched, and passed.
    </p>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold">Articles</h2>
      <p class="mt-2 text-zinc-400">Research papers I have read.</p>
      <LearningList items={articles} empty="No articles listed yet." />
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold">Books</h2>
      <p class="mt-2 text-zinc-400">Books I have read.</p>
      <LearningList items={books} empty="No books listed yet." />
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-semibold">Courses</h2>
      <p class="mt-2 text-zinc-400">Courses I have watched or passed.</p>
      <LearningList
        items={courses.map((course) => ({
          title: course.title,
          authors: course.instructor
            ? `${course.provider} · ${course.instructor}`
            : course.provider,
          year: course.year,
          status: course.status,
          url: course.url,
          notes: course.notes,
        }))}
        empty="No courses listed yet."
      />
    </section>
  </div>
</Layout>
