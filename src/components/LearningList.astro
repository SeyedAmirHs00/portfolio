---
export interface LearningEntry {
  title: string;
  authors?: string;
  venue?: string;
  year?: string;
  status?: string;
  url?: string;
  notes?: string;
}

interface Props {
  items: LearningEntry[];
  empty: string;
}

const { items, empty } = Astro.props;
---

{
  items.length > 0 ? (
    <ul class="mt-6 divide-y divide-zinc-800 border-y border-zinc-800">
      {items.map((item) => (
        <li class="py-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            {item.url ? (
              <a
                href={item.url}
                class="text-lg font-medium text-zinc-100 hover:text-white"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.title}
              </a>
            ) : (
              <h3 class="text-lg font-medium text-zinc-100">{item.title}</h3>
            )}
            {(item.status || item.year) && (
              <span class="text-sm text-zinc-500">
                {[item.status, item.year].filter(Boolean).join(" · ")}
              </span>
            )}
          </div>
          {item.authors && (
            <p class="mt-1 text-sm text-zinc-400">{item.authors}</p>
          )}
          {item.venue && (
            <p class="mt-1 text-sm text-zinc-500">{item.venue}</p>
          )}
          {item.notes && <p class="mt-3 text-zinc-300">{item.notes}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-6 text-zinc-500">{empty}</p>
  )
}
